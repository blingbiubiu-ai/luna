    "./commands/activity": "./src/commands/activity.ts",
    "./commands/tasks": "./src/commands/tasks.ts",
    "./commands/sessions": "./src/commands/sessions.ts",
    "./commands/schedules": "./src/commands/schedules.ts",
    "./commands/chat": "./src/commands/chat.ts",
    "./commands/knowledge": "./src/commands/knowledge.ts",
    "./commands/workspace": "./src/commands/workspace.ts",
    "./commands/artifacts": "./src/commands/artifacts.ts",
