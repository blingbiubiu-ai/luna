# ============================================================
# Luna Shared Runner Base Image
# Shared Executor, client, provider CLIs and general-purpose development tools.
# ============================================================

ARG NODE_IMAGE=node:22-slim

# ---------- Stage 1: Build agent-runner ----------
FROM ${NODE_IMAGE} AS builder

ARG BUN_VERSION=1.3.14
RUN npm install -g bun@${BUN_VERSION}
WORKDIR /build
COPY apps/executor/package.json ./apps/executor/package.json
COPY packages/runner-protocol/package.json ./packages/runner-protocol/package.json
COPY packages/execution-store/package.json ./packages/execution-store/package.json
COPY packages/execution-transport/package.json ./packages/execution-transport/package.json
RUN printf '%s\n' '{"private":true,"workspaces":["packages/*","apps/executor"]}' > package.json \
    && bun install --production
COPY apps/executor/src ./apps/executor/src
COPY packages/runner-protocol/src ./packages/runner-protocol/src
COPY packages/execution-store/src ./packages/execution-store/src
COPY packages/execution-transport/src ./packages/execution-transport/src
RUN bun run --cwd apps/executor build

# ---------- Stage 2: Mutable runner runtime ----------
FROM ${NODE_IMAGE} AS runtime

# Utilities used by the runner and agent CLIs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    python3 \
    unzip \
    file \
    fswatch \
    git \
    jq \
    less \
    openssh-client \
    procps \
    python3-pip \
    python3-venv \
    ripgrep \
    rsync \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Agent CLIs
ARG TARGETARCH
ARG CLAUDE_CODE_VERSION=2.1.319
ARG CODEX_VERSION=0.167.0
# Claude's optional native dependency can fail without failing npm install.
# Install exactly one native package explicitly and execute both CLIs as a gate.
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in amd64) CLAUDE_CPU=x64 ;; arm64) CLAUDE_CPU=arm64 ;; *) exit 1 ;; esac \
    && npm install -g --omit=optional \
      "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
      "@anthropic-ai/claude-code-linux-${CLAUDE_CPU}@${CLAUDE_CODE_VERSION}" \
    && node /usr/local/lib/node_modules/@anthropic-ai/claude-code/install.cjs \
    && npm install -g --include=optional "@openai/codex@${CODEX_VERSION}" \
    && claude --version && codex --version \
    && npm cache clean --force

RUN printf '%s\n' \
    'export PATH="$HOME/.luna-resources/commands:$HOME/.local/bin:/opt/luna-runtime/current/bin:$PATH"' \
    > /etc/profile.d/luna-path.sh

# Install bun — needed to run the luna CLI (built with bun target)
ARG BUN_VERSION=1.3.14
RUN npm install -g bun@${BUN_VERSION} \
    && bun --version

# Official Chrome stable on amd64; Debian Chromium on arm64 (linked at /usr/bin/google-chrome),
# including shared-library dependencies and CJK fonts for headless screenshots/PDFs and VNC.
RUN apt-get update \
    && case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
      amd64) \
        curl -fsSL --retry 3 https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb -o /tmp/google-chrome.deb \
        && apt-get install -y --no-install-recommends /tmp/google-chrome.deb fonts-noto-cjk fonts-noto-color-emoji \
        && rm -f /tmp/google-chrome.deb ;; \
      arm64) \
        apt-get install -y --no-install-recommends chromium fonts-noto-cjk fonts-noto-color-emoji \
        && ln -sf /usr/bin/chromium /usr/bin/google-chrome ;; \
      *) exit 1 ;; \
    esac \
    && google-chrome --version \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/google-chrome \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Dashboard remote desktop: a virtual display, openbox with a tint2 panel, a terminal
# and a VNC server, started on demand by luna-desktop. Menus list .desktop entries, so
# software that ships one (or one added under ~/.local/share/applications) appears there.
# Chrome/Chromium entries go through the container wrapper (/usr/local/bin/google-chrome).
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    x11-xserver-utils \
    openbox \
    tint2 \
    lxterminal \
    && rm -rf /var/lib/apt/lists/* \
    && if [ -f /usr/share/applications/google-chrome.desktop ]; then \
         sed -i 's#^Exec=/usr/bin/google-chrome-stable#Exec=/usr/local/bin/google-chrome#' /usr/share/applications/google-chrome.desktop \
         && grep -q '^Exec=/usr/local/bin/google-chrome' /usr/share/applications/google-chrome.desktop; \
       elif [ -f /usr/share/applications/chromium.desktop ]; then \
         sed -i 's#^Exec=/usr/bin/chromium#Exec=/usr/local/bin/google-chrome#' /usr/share/applications/chromium.desktop \
         && grep -q '^Exec=/usr/local/bin/google-chrome' /usr/share/applications/chromium.desktop; \
       fi \
    && sed -i 's#^Exec=lxterminal.*#Exec=/usr/local/bin/luna-terminal#' /usr/share/applications/lxterminal.desktop \
    && grep -q '^Exec=/usr/local/bin/luna-terminal' /usr/share/applications/lxterminal.desktop \
    && for app in tint2 tint2conf x11vnc; do echo 'NoDisplay=true' >> "/usr/share/applications/$app.desktop"; done

# Reuse node user (UID 1000 already exists in node:22-slim). This passwd home
# is only account metadata; Luna injects the shared HOME and the session/task working directory.
RUN usermod -l runner -d /home/runner -m node 2>/dev/null || true \
    && groupmod -n runner node 2>/dev/null || true \
    && mkdir -p /home/runner \
    && chown -R runner:runner /home/runner

# Directory layout
RUN mkdir -p /run/luna && chmod 0700 /run/luna

RUN mkdir -p /tmp/agent-runner /app/luna-cli \
    && chown -R runner:runner /tmp/agent-runner

# Copy luna CLI wrapper script
COPY container/luna /usr/local/bin/luna
COPY dist/luna-client.js /app/luna-cli/cli.js

# Copy built agent-runner from builder
COPY --from=builder /build/apps/executor/dist /app/agent-runner/dist

COPY container/npm-global.sh /etc/profile.d/luna-npm-global.sh
COPY container/luna-desktop /usr/local/bin/luna-desktop
COPY container/google-chrome /usr/local/bin/google-chrome
COPY container/luna-home-sanitize /usr/local/bin/luna-home-sanitize
COPY container/desktop/luna-terminal container/desktop/luna-apps-menu /usr/local/bin/
COPY container/desktop/menu.xml /etc/xdg/openbox/menu.xml
COPY container/desktop/tint2rc /etc/xdg/tint2/tint2rc
COPY container/luna-prompt.sh /etc/profile.d/luna-prompt.sh
# Containers cannot enable Chrome's sandbox (no-new-privileges); hide the --no-sandbox banner.
COPY container/chrome-policy.json /etc/opt/chrome/policies/managed/luna.json
COPY container/chrome-policy.json /etc/chromium/policies/managed/luna.json
RUN chmod +x /usr/local/bin/luna /usr/local/bin/luna-desktop /usr/local/bin/google-chrome /usr/local/bin/luna-terminal /usr/local/bin/luna-apps-menu /usr/local/bin/luna-home-sanitize

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

USER runner
ENTRYPOINT ["bun", "/app/agent-runner/dist/executor.js"]
