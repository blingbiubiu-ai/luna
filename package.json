{
  "name": "@luna/workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "type": "module",
  "bin": {
    "luna": "dist/luna-client.js",
    "luna-service": "dist/luna-service.js",
    "luna-worker": "dist/luna-worker.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun && bun run --cwd apps/cli build && cp apps/cli/dist/luna-client.js dist/luna-client.js && bun build src/cli/server-main.ts --outfile dist/luna-service.js --target bun && bun run --cwd apps/worker build && cp apps/worker/dist/luna-worker.js dist/luna-worker.js && bun run --cwd apps/dashboard build",
    "test": "bun test",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/.bin/tsc --noEmit -p tsconfig.base.json && bun run --cwd apps/dashboard typecheck"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@hono/zod-validator": "^0.7.6",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@novnc/novnc": "^1.7.0",
    "@radix-ui/react-use-controllable-state": "^1.2.2",
    "@rive-app/react-webgl2": "^4.28.6",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.193",
    "ansi-to-react": "^6.2.6",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cronstrue": "^3.14.0",
    "dayjs": "^1.11.21",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "eventemitter3": "^5.0.4",
    "hono": "^4.12.23",
    "image-size": "2.0.4",
    "lucide-react": "^1.17.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "radix-ui": "^1.4.3",
    "react-jsx-parser": "^2.4.1",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tokenlens": "^1.3.1",
    "use-stick-to-bottom": "^1.1.4",
    "uuid": "^13.0.0",
    "yaml": "^2.7.0",
    "zod": "^4.4.3",
    "@luna/execution-store": "workspace:*",
    "@luna/execution-transport": "workspace:*",
    "@luna/runner-protocol": "workspace:*",
    "@luna/plugin-contracts": "workspace:*",
    "@luna/service-client": "workspace:*",
    "@luna/host-runtime": "workspace:*",
    "@luna/cli-support": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "linkedom": "^0.18.12",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "@luna/worker": "workspace:*",
    "@luna/cli": "workspace:*",
    "@luna/executor": "workspace:*"
  }
}
